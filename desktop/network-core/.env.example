# DualFlow Network Core - Environment Configuration Template
# Copy this file to .env or export these variables in your shell.
# DO NOT commit real keys or production secrets to source control.

# ------------------------------------------------------------------------------
# Secure Relay Configuration
# ------------------------------------------------------------------------------
# 32-byte hex-encoded Pre-Shared Key (PSK) for Noise_IKpsk2 handshake.
# Generate with: openssl rand -hex 32
DUALFLOW_RELAY_PSK=

# 32-byte hex-encoded private static key for the DualFlow Secure Relay server.
# If omitted, the relay generates an ephemeral keypair on startup.
DUALFLOW_RELAY_STATIC_KEY=

# UDP listen address for the Secure Relay server.
# Default: 0.0.0.0:51820
DUALFLOW_RELAY_LISTEN=0.0.0.0:51820

# ------------------------------------------------------------------------------
# Integration Testing Configuration
# ------------------------------------------------------------------------------
# Remote Relay endpoint for physical network aggregation benchmarking.
# Required only by TestPhase7PhysicalThroughputMeasurementHarness.
# If unset, the physical measurement test is safely skipped.
# Example: 192.168.1.50:51820
DUALFLOW_TEST_REMOTE_RELAY=
